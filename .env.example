# ==============================================================================
# SKINTRACE AI — Environment Configuration & YouCam Skin AI v2.1 Architecture
# ==============================================================================

# DEMO_MODE: MANDATORY ZERO-CONSUMPTION SAFEGUARD (Default: "true")
# When set to "true", the server intercepts all analysis requests and delivers
# local deterministic demo data conforming to the official YouCam v2.1 schema.
# ABSOLUTELY ZERO outbound network calls are made to Perfect Corp servers.
# 100% of your 40 bonus API units remain permanently protected.
DEMO_MODE="true"

# YOUCAM_API_KEY: Official YouCam Skin Analysis API Secret (v2.1)
# Documentation: https://docs.perfectcorp.com/reference/ai_skin_analysis/v2.1
# Production Base Host: https://yce-api-01.makeupar.com
# Endpoints:
#   - Task Creation: POST /s2s/v2.1/task/skin-analysis
#   - Polling:       GET  /s2s/v2.1/task/skin-analysis/{task_id}
#
# IMPORTANT SECURITY RULES:
# 1. In demo mode and public git repositories, keep this set to "demo-placeholder".
# 2. Never expose this secret to frontend browser code, bundles, or client logs.
# 3. Only set to a real key on a secure server when DEMO_MODE is intentionally set to "false".
YOUCAM_API_KEY="demo-placeholder"
# Optional alternate variable name supported by the server:
# YOUCAM_SECRET_KEY="demo-placeholder"

# GEMINI_API_KEY: Optional runtime key automatically injected by AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosting URL injected by Cloud Run or local environment.
APP_URL="MY_APP_URL"
