# ==============================================================================
# SKINTRACE AI — Environment Configuration
# ==============================================================================

# DEMO_MODE: STRICT ZERO-CONSUMPTION SAFEGUARD
# When set to "true" (default), no external API requests are made.
# All skin analysis processing runs locally and deterministic demo data is returned.
# Keeps the 40 YouCam bonus credits 100% safe during testing and judging.
DEMO_MODE="true"

# YOUCAM_API_KEY: Future live YouCam Skin Analysis API Secret.
# In development and demo mode, keep set to "demo-placeholder".
YOUCAM_API_KEY="demo-placeholder"

# GEMINI_API_KEY: Optional runtime key automatically injected by AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosting URL injected by Cloud Run or local environment.
APP_URL="MY_APP_URL"
